                          case case_3
                          solve( (#i = #vr.5)  ∥ (#vr.5 < #i) )
                            case case_1
                            by contradiction /* contradictory subterm store */
                          next
                            case case_2
                            by contradiction /* non-injective facts (#vr.5,#i,#j) */
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              next
                case c_sign
                solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #i )
                  case Accept_first
                  solve( !KU( sign(<'authbc', $S, %last, data.2>, ~sk) ) @ #vk.23 )
                    case Send
                    solve( !Ltk( $S, sk.1 ) ▶₀ #s )
                      case Register_key
                      solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                        case Accept_first
                        by contradiction /* cyclic */
                      next
                        case Accept_gap
                        by contradiction /* cyclic */
                      next
                        case Accept_next
                        by contradiction /* from formulas */
                      qed
                    qed
                  next
                    case c_sign
                    solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* cyclic */
                    next
                      case Accept_gap
                      by contradiction /* cyclic */
                    next
                      case Accept_next
                      by contradiction /* from formulas */
                    qed
                  qed
                next
                  case Accept_gap
                  solve( !KU( sign(<'authbc', $S, %last, data.2>, ~sk) ) @ #vk.23 )
                    case Send
                    solve( !Ltk( $S, sk.1 ) ▶₀ #s )
                      case Register_key
                      solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                        case Accept_first
                        by contradiction /* cyclic */
                      next
                        case Accept_gap
                        by contradiction /* cyclic */
                      next
                        case Accept_next
                        by contradiction /* cyclic */
                      qed
                    qed
                  next
                    case c_sign
                    solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* cyclic */
                    next
                      case Accept_gap
                      by contradiction /* cyclic */
                    next
                      case Accept_next
                      by contradiction /* cyclic */
                    qed
                  qed
                next
                  case Accept_next
                  simplify
                  solve( !KU( sign(<'authbc', $S, (%last%+%1), data.2>, ~sk) ) @ #vk.23 )
                    case Send
                    solve( !Ltk( $S, sk.1 ) ▶₀ #s )
                      case Register_key
                      solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                        case Accept_first
                        by contradiction /* cyclic */
                      next
                        case Accept_gap
                        by contradiction /* cyclic */
                      next
                        case Accept_next
                        simplify
                        solve( (#vr.5 = #vr.2)  ∥ (#vr.2 < #vr.5)  ∥
                               ((%last.1%+%1) ⊏ (%last%+%1)) )
                          case case_1
                          by contradiction /* cyclic */
                        next
                          case case_2
                          by contradiction /* from formulas */
                        next
                          case case_3
                          solve( (#i = #vr.5)  ∥ (#vr.5 < #i) )
                            case case_1
                            by contradiction /* contradictory subterm store */
                          next
                            case case_2
                            by contradiction /* non-injective facts (#vr.5,#i,#j) */
                          qed
                        qed
                      qed
                    qed
                  next
                    case c_sign
                    solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* cyclic */
                    next
                      case Accept_gap
                      by contradiction /* cyclic */
                    next
                      case Accept_next
                      simplify
                      solve( (#vr.3 = #vr.2)  ∥ (#vr.2 < #vr.3)  ∥
                             ((%last.1%+%1) ⊏ (%last%+%1)) )
                        case case_1
                        by contradiction /* cyclic */
                      next
                        case case_2
                        by contradiction /* from formulas */
                      next
                        case case_3
                        solve( (#i = #vr.3)  ∥ (#vr.3 < #i) )
                          case case_1
                          by contradiction /* contradictory subterm store */
                        next
                          case case_2
                          by contradiction /* non-injective facts (#vr.3,#i,#j) */
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma receiver_session_has_start [use_induction, reuse]:
  all-traces
  "∀ rid R S %n #i.
    (AcceptIn( rid, R, S, %n ) @ #i) ⇒
    (∃ #s. (ReceiverStart( R, S, rid ) @ #s) ∧ (#s < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ rid R S %n #i.
  (AcceptIn( rid, R, S, %n ) @ #i)
 ∧
  ∀ #s. (ReceiverStart( R, S, rid ) @ #s) ⇒ ¬(#s < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #s. (ReceiverStart( R, S, rid ) @ #s) ∧ (¬(last(#s))) ∧ (#s < #i)) )
    case case_1
    solve( AcceptIn( rid, R, S, %n ) @ #i )
      case Accept_first
      solve( Rcv( ~rid, $R, $S, 'none' ) ▶₀ #i )
        case Receiver_start
        by contradiction /* from formulas */
      qed
    next
      case Accept_gap
      solve( !Pk( $S, pk(x) ) ▶₂ #i )
        case Register_key
        solve( !KU( sign(<'authbc', $S, %n, data>, ~sk) ) @ #vk.8 )
          case Send
          solve( !Ltk( $S, sk.1 ) ▶₀ #s )
            case Register_key
            solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #i )
              case Accept_first
              by contradiction /* from formulas */
            next
              case Accept_gap
              by contradiction /* from formulas */
            next
              case Accept_next
              by contradiction /* from formulas */
            qed
          qed
        next
          case c_sign
          solve( !KU( ~sk ) @ #vk.9 )
            case Reveal_key
            solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #i )
              case Accept_first
              by contradiction /* from formulas */
            next
              case Accept_gap
              by contradiction /* from formulas */
            next
              case Accept_next
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case Accept_next
      solve( !Pk( $S, pk(x) ) ▶₂ #i )
        case Register_key
        solve( !KU( sign(<'authbc', $S, (%last%+%1), data>, ~sk) ) @ #vk.8 )
          case Send
          solve( !Ltk( $S, sk.1 ) ▶₀ #s )
            case Register_key
            solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #i )
              case Accept_first
              by contradiction /* from formulas */
            next
              case Accept_gap
              by contradiction /* from formulas */
            next
              case Accept_next
              by contradiction /* from formulas */
            qed
          qed
        next
          case c_sign
          solve( !KU( ~sk ) @ #vk.9 )
            case Reveal_key
            solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #i )
              case Accept_first
              by contradiction /* from formulas */
            next
              case Accept_gap
              by contradiction /* from formulas */
            next
              case Accept_next
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

