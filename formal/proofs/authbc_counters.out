by contradiction /* from formulas */

lemma accept_seq_increases [reuse]:
  all-traces
  "∀ R S %n %m d1 d2 #i #j.
    (((Accept( R, S, %n, d1 ) @ #i) ∧ (Accept( R, S, %m, d2 ) @ #j)) ∧
