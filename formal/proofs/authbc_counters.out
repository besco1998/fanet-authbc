theory AUTHBC_Frames_Counters

begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

/* looping facts with injective instances: Rcv/4, Snd/3 */

rule (modulo E) Register_key:
   [ Fr( ~sk ) ]
  --[ OnlyOnce( <'key', $S> ) ]->
   [ !Ltk( $S, ~sk ), !Pk( $S, pk(~sk) ), Out( pk(~sk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_key:
   [ !Ltk( $S, sk ) ] --[ Reveal( $S ) ]-> [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sender_start:
   [ !Ltk( $S, sk ), Fr( ~sid ) ]
  --[ OnlyOnce( <'sender', $S> ), SenderStart( $S, ~sid ) ]->
   [ Snd( ~sid, $S, %1 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Send:
   [ Snd( ~sid, $S, %seq ), !Ltk( $S, sk ), Fr( ~data ) ]
  --[ Sent( $S, %seq, ~data ), SentIn( ~sid, $S, %seq ) ]->
   [
   Snd( ~sid, $S, (%seq%+%1) ),
   Out( <<'authbc', $S, %seq, ~data>, sign(<'authbc', $S, %seq, ~data>, sk)>
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Receiver_start:
   [ Fr( ~rid ), !Pk( $S, pkS ) ]
  --[ OnlyOnce( <'receiver', $R, $S> ), ReceiverStart( $R, $S, ~rid ) ]->
   [ Rcv( ~rid, $R, $S, 'none' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Accept_first:
   [
   Rcv( ~rid, $R, $S, 'none' ), In( <<'authbc', $S, %seq, data>, sig> ),
   !Pk( $S, pkS )
   ]
  --[
  Eq( verify(sig, <'authbc', $S, %seq, data>, pkS), true ),
  Accept( $R, $S, %seq, data ), AcceptIn( ~rid, $R, $S, %seq )
  ]->
   [
   Rcv( ~rid, $R, $S, %seq ),
   !Stored( $R, $S, %seq, <'authbc', $S, %seq, data> )
   ]

  /*
  rule (modulo AC) Accept_first:
     [
     Rcv( ~rid, $R, $S, 'none' ), In( <<'authbc', $S, %seq, data>, sig> ),
     !Pk( $S, pkS )
     ]
    --[
    Eq( z, true ), Accept( $R, $S, %seq, data ),
    AcceptIn( ~rid, $R, $S, %seq )
    ]->
     [
     Rcv( ~rid, $R, $S, %seq ),
     !Stored( $R, $S, %seq, <'authbc', $S, %seq, data> )
     ]
    variants (modulo AC)
    1. $S    = $S.17
       data  = data.19
       pkS   = pkS.20
       sig   = sig.21
       z     = verify(sig.21, <'authbc', $S.17, %seq.22, data.19>, pkS.20)
       %seq  = %seq.22
    
    2. $S    = $S.24
       data  = data.26
       pkS   = pk(x.45)
       sig   = sign(<'authbc', $S.24, %seq.29, data.26>, x.45)
       z     = true
       %seq  = %seq.29
  */

rule (modulo E) Accept_next:
   [
   Rcv( ~rid, $R, $S, %last ),
   In( <<'authbc', $S, (%last%+%1), data>, sig> ), !Pk( $S, pkS )
   ]
  --[
  Eq( verify(sig, <'authbc', $S, (%last%+%1), data>, pkS), true ),
  Accept( $R, $S, (%last%+%1), data ),
  AcceptIn( ~rid, $R, $S, (%last%+%1) )
  ]->
   [
   Rcv( ~rid, $R, $S, (%last%+%1) ),
   !Stored( $R, $S, (%last%+%1), <'authbc', $S, (%last%+%1), data> )
   ]

  // loop breaker: [0]
  /*
  rule (modulo AC) Accept_next:
     [
     Rcv( ~rid, $R, $S, %last ),
     In( <<'authbc', $S, (%last%+%1), data>, sig> ), !Pk( $S, pkS )
     ]
    --[
    Eq( z, true ), Accept( $R, $S, (%last%+%1), data ),
    AcceptIn( ~rid, $R, $S, (%last%+%1) )
    ]->
     [
     Rcv( ~rid, $R, $S, (%last%+%1) ),
     !Stored( $R, $S, (%last%+%1), <'authbc', $S, (%last%+%1), data> )
     ]
    variants (modulo AC)
    1. $S    = $S.11
       data  = data.13
       pkS   = pkS.14
       sig   = sig.15
       z     = verify(sig.15, <'authbc', $S.11, (%last.16%+%1), data.13>,
                      pkS.14)
       %last = %last.16
    
    2. $S    = $S.15
       data  = data.17
       pkS   = pk(x.26)
       sig   = sign(<'authbc', $S.15, (%last.20%+%1), data.17>, x.26)
       z     = true
       %last = %last.20
    // loop breaker: [0]
  */

rule (modulo E) Accept_gap:
   [
   Rcv( ~rid, $R, $S, %last ), In( <<'authbc', $S, %seq, data>, sig> ),
   !Pk( $S, pkS )
   ]
  --[
  Eq( verify(sig, <'authbc', $S, %seq, data>, pkS), true ),
  Less( (%last%+%1), %seq ), Accept( $R, $S, %seq, data ),
  AcceptIn( ~rid, $R, $S, %seq ), Gap( $R, $S, %last, %seq )
  ]->
   [
   Rcv( ~rid, $R, $S, %seq ),
   !Stored( $R, $S, %seq, <'authbc', $S, %seq, data> )
   ]

  // loop breaker: [0]
  /*
  rule (modulo AC) Accept_gap:
     [
     Rcv( ~rid, $R, $S, %last ), In( <<'authbc', $S, %seq, data>, sig> ),
     !Pk( $S, pkS )
     ]
    --[
    Eq( z, true ), Less( (%last%+%1), %seq ), Accept( $R, $S, %seq, data ),
    AcceptIn( ~rid, $R, $S, %seq ), Gap( $R, $S, %last, %seq )
    ]->
     [
     Rcv( ~rid, $R, $S, %seq ),
     !Stored( $R, $S, %seq, <'authbc', $S, %seq, data> )
     ]
    variants (modulo AC)
    1. $S    = $S.12
       data  = data.14
       pkS   = pkS.15
       sig   = sig.16
       z     = verify(sig.16, <'authbc', $S.12, %seq.18, data.14>, pkS.15)
       %seq  = %seq.18
    
    2. $S    = $S.16
       data  = data.18
       pkS   = pk(x.28)
       sig   = sign(<'authbc', $S.16, %seq.22, data.18>, x.28)
       z     = true
       %seq  = %seq.22
    // loop breaker: [0]
  */

rule (modulo E) Evidence:
   [
   !Stored( $R, $S, %seq, <'authbc', $S, %seq, d1> ),
   In( <<'authbc', $S, %seq, d2>, sig> ), !Pk( $S, pkS )
   ]
  --[
  Eq( verify(sig, <'authbc', $S, %seq, d2>, pkS), true ),
  Neq( <'authbc', $S, %seq, d1>, <'authbc', $S, %seq, d2> ),
  Equivocation( $R, $S, %seq )
  ]->
   [ ]

  /*
  rule (modulo AC) Evidence:
     [
     !Stored( $R, $S, %seq, <'authbc', $S, %seq, d1> ),
     In( <<'authbc', $S, %seq, d2>, sig> ), !Pk( $S, pkS )
     ]
    --[
    Eq( z, true ), Neq( <'authbc', $S, %seq, d1>, <'authbc', $S, %seq, d2> ),
    Equivocation( $R, $S, %seq )
    ]->
     [ ]
    variants (modulo AC)
    1. $S    = $S.11
       d2    = d2.13
       pkS   = pkS.14
       sig   = sig.15
       z     = verify(sig.15, <'authbc', $S.11, %seq.16, d2.13>, pkS.14)
       %seq  = %seq.16
    
    2. $S    = $S.15
       d2    = d2.17
       pkS   = pk(x.26)
       sig   = sign(<'authbc', $S.15, %seq.20, d2.17>, x.26)
       z     = true
       %seq  = %seq.20
  */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  */

restriction Less_than:
  "∀ x y #i. (Less( x, y ) @ #i) ⇒ (x ⊏ y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Less( x, y ) @ #i) ⇒ (x ⊏ y)"
  */

restriction Only_once:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i #j. ((OnlyOnce( x ) @ #i) ∧ (OnlyOnce( x ) @ #j)) ⇒ (#i = #j)"
  */

lemma sender_session_counter_increases [reuse]:
  all-traces
  "∀ sid S %n %m #i #j.
    (((SentIn( sid, S, %n ) @ #i) ∧ (SentIn( sid, S, %m ) @ #j)) ∧
     (#i < #j)) ⇒
    (%n ⊏ %m)"
/*
guarded formula characterizing all counter-examples:
"∃ sid S %n %m #i #j.
  (SentIn( sid, S, %n ) @ #i) ∧ (SentIn( sid, S, %m ) @ #j)
 ∧
  (#i < #j) ∧ (¬(%n ⊏ %m))"
*/
simplify
by contradiction /* cyclic */

lemma sender_session_has_start [use_induction, reuse]:
  all-traces
  "∀ sid S %n #i.
    (SentIn( sid, S, %n ) @ #i) ⇒
    (∃ #s. (SenderStart( S, sid ) @ #s) ∧ (#s < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ sid S %n #i.
  (SentIn( sid, S, %n ) @ #i)
 ∧
  ∀ #s. (SenderStart( S, sid ) @ #s) ⇒ ¬(#s < #i)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #s. (SenderStart( $S, ~sid ) @ #s) ∧ (¬(last(#s))) ∧ (#s < #i)) )
    case case_1
    solve( !Ltk( $S, sk ) ▶₁ #i )
      case Register_key
      solve( Snd( ~sid, $S, %n ) ▶₀ #i )
        case Send
        by contradiction /* from formulas */
      next
        case Sender_start
        by contradiction /* from formulas */
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

lemma one_session_per_sender [reuse]:
  all-traces
  "∀ s1 s2 S %n %m #i #j.
    ((SentIn( s1, S, %n ) @ #i) ∧ (SentIn( s2, S, %m ) @ #j)) ⇒ (s1 = s2)"
/*
guarded formula characterizing all counter-examples:
"∃ s1 s2 S %n %m #i #j.
  (SentIn( s1, S, %n ) @ #i) ∧ (SentIn( s2, S, %m ) @ #j) ∧ ¬(s1 = s2)"
*/
simplify
by contradiction /* from formulas */

lemma sent_seq_increases [reuse]:
  all-traces
  "∀ S %n %m d1 d2 #i #j.
    (((Sent( S, %n, d1 ) @ #i) ∧ (Sent( S, %m, d2 ) @ #j)) ∧ (#i < #j)) ⇒
    (%n ⊏ %m)"
/*
guarded formula characterizing all counter-examples:
"∃ S %n %m d1 d2 #i #j.
  (Sent( S, %n, d1 ) @ #i) ∧ (Sent( S, %m, d2 ) @ #j)
 ∧
  (#i < #j) ∧ (¬(%n ⊏ %m))"
*/
simplify
by contradiction /* cyclic */

lemma receiver_session_counter_increases [use_induction, reuse]:
  all-traces
  "∀ rid R S %n %m #i #j.
    (((AcceptIn( rid, R, S, %n ) @ #i) ∧ (AcceptIn( rid, R, S, %m ) @ #j)) ∧
     (#i < #j)) ⇒
    (%n ⊏ %m)"
/*
guarded formula characterizing all counter-examples:
"∃ rid R S %n %m #i #j.
  (AcceptIn( rid, R, S, %n ) @ #i) ∧ (AcceptIn( rid, R, S, %m ) @ #j)
 ∧
  (#i < #j) ∧ (¬(%n ⊏ %m))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( AcceptIn( rid, R, S, %n ) @ #i )
    case Accept_first
    simplify
    solve( Rcv( ~rid, $R, $S, 'none' ) ▶₀ #i )
      case Receiver_start
      solve( !Pk( $S, pk(x) ) ▶₂ #i )
        case Register_key
        solve( AcceptIn( ~rid, $R, $S, %m ) @ #j )
          case Accept_first
          simplify
          solve( Rcv( ~rid, $R, $S, 'none' ) ▶₀ #j )
            case Receiver_start
            by contradiction /* cyclic */
          qed
        next
          case Accept_gap
          simplify
          solve( !Pk( $S, pk(x) ) ▶₂ #j )
            case Register_key
            solve( !KU( sign(<'authbc', $S, %n, data>, ~sk) ) @ #vk.11 )
              case Send
              solve( !Ltk( $S, sk.1 ) ▶₀ #s )
                case Register_key
                solve( !KU( sign(<'authbc', $S, %m, data.1>, ~sk) ) @ #vk.15 )
                  case Send
                  solve( (¬(#vr.4 < #vr.2))  ∥ (%m ⊏ %n) )
                    case case_1
                    solve( (#vr.2 = #vr.4)  ∥ (#vr.4 < #vr.2) )
                      case case_1
                      solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                        case Accept_first
                        by contradiction /* contradictory subterm store */
                      next
                        case Accept_gap
                        by contradiction /* from formulas */
                      next
                        case Accept_next
                        by contradiction /* from formulas */
                      qed
                    next
                      case case_2
                      by contradiction /* from formulas */
                    qed
                  next
                    case case_2
                    solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* contradictory subterm store */
                    next
                      case Accept_gap
                      by contradiction /* from formulas */
                    next
                      case Accept_next
                      by contradiction /* from formulas */
                    qed
                  qed
                next
                  case c_sign
                  solve( !KU( ~sk ) @ #vk.16 )
                    case Reveal_key
                    solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* contradictory subterm store */
                    next
                      case Accept_gap
                      by contradiction /* from formulas */
                    next
                      case Accept_next
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case c_sign
              solve( !KU( ~sk ) @ #vk.16 )
                case Reveal_key
                solve( !KU( sign(<'authbc', $S, %m, data.1>, ~sk) ) @ #vk.16 )
                  case Send
                  solve( !Ltk( $S, sk.1 ) ▶₀ #s )
                    case Register_key
                    solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* contradictory subterm store */
                    next
                      case Accept_gap
                      by contradiction /* from formulas */
                    next
                      case Accept_next
                      by contradiction /* from formulas */
                    qed
                  qed
                next
                  case c_sign
                  solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                    case Accept_first
                    by contradiction /* contradictory subterm store */
                  next
                    case Accept_gap
                    by contradiction /* from formulas */
                  next
                    case Accept_next
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          qed
        next
          case Accept_next
          simplify
          solve( !Pk( $S, pk(x) ) ▶₂ #j )
            case Register_key
            solve( !KU( sign(<'authbc', $S, %n, data>, ~sk) ) @ #vk.11 )
              case Send
              solve( !Ltk( $S, sk.1 ) ▶₀ #s )
                case Register_key
                solve( !KU( sign(<'authbc', $S, (%last%+%1), data.1>, ~sk) ) @ #vk.15 )
                  case Send
                  solve( (¬(#vr.4 < #vr.2))  ∥ ((%last%+%1) ⊏ %n) )
                    case case_1
                    solve( (#vr.2 = #vr.4)  ∥ (#vr.4 < #vr.2) )
                      case case_1
                      solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                        case Accept_gap
                        by contradiction /* from formulas */
                      next
                        case Accept_next
                        by contradiction /* from formulas */
                      qed
                    next
                      case case_2
                      by contradiction /* from formulas */
                    qed
                  next
                    case case_2
                    solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* cyclic */
                    next
                      case Accept_gap
                      by contradiction /* from formulas */
                    next
                      case Accept_next
                      by contradiction /* from formulas */
                    qed
                  qed
                next
                  case c_sign
                  solve( !KU( ~sk ) @ #vk.16 )
                    case Reveal_key
                    solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* contradictory subterm store */
                    next
                      case Accept_gap
                      by contradiction /* from formulas */
                    next
                      case Accept_next
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case c_sign
              solve( !KU( ~sk ) @ #vk.16 )
                case Reveal_key
                solve( !KU( sign(<'authbc', $S, (%last%+%1), data.1>, ~sk) ) @ #vk.16 )
                  case Send
                  solve( !Ltk( $S, sk.1 ) ▶₀ #s )
                    case Register_key
                    solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                      case Accept_first
                      by contradiction /* contradictory subterm store */
                    next
                      case Accept_gap
                      by contradiction /* from formulas */
                    next
                      case Accept_next
                      by contradiction /* from formulas */
                    qed
                  qed
                next
                  case c_sign
                  solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #j )
                    case Accept_first
                    by contradiction /* contradictory subterm store */
                  next
                    case Accept_gap
                    by contradiction /* from formulas */
                  next
                    case Accept_next
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Accept_gap
    simplify
    solve( !Pk( $S, pk(x) ) ▶₂ #i )
      case Register_key
      solve( AcceptIn( ~rid, $R, $S, %m ) @ #j )
        case Accept_first
        simplify
        solve( Rcv( ~rid, $R, $S, 'none' ) ▶₀ #j )
          case Receiver_start
          by contradiction /* cyclic */
        qed
      next
        case Accept_gap
        simplify
        solve( !Pk( $S, pk(x) ) ▶₂ #j )
          case Register_key
          solve( !KU( sign(<'authbc', $S, %n, data>, ~sk) ) @ #vk.11 )
            case Send
            solve( !Ltk( $S, sk.1 ) ▶₀ #s )
              case Register_key
              solve( !KU( sign(<'authbc', $S, %m, data.1>, ~sk) ) @ #vk.15 )
                case Send
                solve( (¬(#vr.3 < #vr.1))  ∥ (%m ⊏ %n) )
                  case case_1
                  solve( (#vr.1 = #vr.3)  ∥ (#vr.3 < #vr.1) )
                    case case_1
                    solve( Rcv( ~rid, $R, $S, %last ) ▶₀ #i )
                      case Accept_first
                      solve( !KU( sign(<'authbc', $S, %last, data.1>, ~sk) ) @ #vk.15 )
                        case Send
                        solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                          case Accept_first
                          by contradiction /* cyclic */
                        next
                          case Accept_gap
                          solve( (#vr.7 = #i)  ∥ (#i < #vr.7)  ∥ (%last.1 ⊏ %m) )
                            case case_1
                            by contradiction /* contradictory subterm store */
                          next
                            case case_2
                            by contradiction /* from formulas */
                          next
                            case case_3
                            solve( (#i = #vr.7)  ∥ (#vr.7 < #i) )
                              case case_1
                              by contradiction /* contradictory subterm store */
                            next
                              case case_2
                              by contradiction /* cyclic */
                            qed
                          qed
                        next
                          case Accept_next
                          by contradiction /* cyclic */
                        qed
                      next
                        case c_sign
                        solve( !KU( ~sk ) @ #vk.16 )
                          case Reveal_key
                          solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                            case Accept_first
                            by contradiction /* cyclic */
                          next
                            case Accept_gap
                            solve( (#vr.6 = #i)  ∥ (#i < #vr.6)  ∥ (%last.1 ⊏ %m) )
                              case case_1
                              by contradiction /* contradictory subterm store */
                            next
                              case case_2
                              by contradiction /* from formulas */
                            next
                              case case_3
                              solve( (#i = #vr.6)  ∥ (#vr.6 < #i) )
                                case case_1
                                by contradiction /* contradictory subterm store */
                              next
                                case case_2
                                by contradiction /* cyclic */
                              qed
                            qed
                          next
                            case Accept_next
                            by contradiction /* cyclic */
                          qed
                        qed
                      qed
                    next
                      case Accept_gap
                      solve( !KU( sign(<'authbc', $S, %last, data.1>, ~sk) ) @ #vk.15 )
                        case Send
                        solve( Rcv( ~rid, $R, $S, %last.1 ) ▶₀ #j )
                          case Accept_first
                          by contradiction /* cyclic */
                        next
                          case Accept_gap
                          solve( (#vr.6 = #i)  ∥ (#i < #vr.6)  ∥ (%last.1 ⊏ %m) )
                            case case_1
                            by contradiction /* contradictory subterm store */
                          next
                            case case_2
                            by contradiction /* from formulas */
                          next
                            case case_3
                            solve( (#vr.6 = #vr.3)  ∥ (#vr.3 < #vr.6)  ∥ (%last.1 ⊏ %last) )
                              case case_1
                              by contradiction /* cyclic */
                            next
                              case case_2
                              solve( (#i = #vr.6)  ∥ (#vr.6 < #i) )
                                case case_1
                                by contradiction /* contradictory subterm store */
                              next
                                case case_2
                                by contradiction /* non-injective facts (#vr.3,#vr.6,#i) */
                              qed
                            next
                              case case_3
                              solve( (#i = #vr.6)  ∥ (#vr.6 < #i) )
                                case case_1
                                by contradiction /* cyclic */
                              next
