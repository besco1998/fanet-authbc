lemma a_skipped_frame_is_detected:
  all-traces
  "∀ R S %n d1 d3 #i #k.
    ((((Accept( R, S, %n, d1 ) @ #i) ∧
       (Accept( R, S, (%n%+%1%+%1), d3 ) @ #k)) ∧
      (#i < #k)) ∧
     (¬(∃ d2 #j. Accept( R, S, (%n%+%1), d2 ) @ #j))) ⇒
    (∃ #g. Gap( R, S, %n, (%n%+%1%+%1) ) @ #g)"
/*
guarded formula characterizing all counter-examples:
"∃ R S %n d1 d3 #i #k.
  (Accept( R, S, %n, d1 ) @ #i) ∧ (Accept( R, S, (%n%+%1%+%1), d3 ) @ #k)
 ∧
  (#i < #k) ∧
  (∀ d2 #j. (Accept( R, S, (%n%+%1), d2 ) @ #j) ⇒ ⊥) ∧
  (∀ #g. (Gap( R, S, %n, (%n%+%1%+%1) ) @ #g) ⇒ ⊥)"
*/
simplify
solve( Accept( R, S, %n, d1 ) @ #i )
  case Accept_first
  solve( Rcv( ~rid, $R, $S, 'none' ) ▶₀ #i )
    case Receiver_start
