      next
        case Accept_gap
        by contradiction /* from formulas */
      next
        case Accept_next
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case Accept_gap
  simplify
  solve( !Pk( $S, pk(x) ) ▶₂ #i )
    case Register_key
    solve( !Pk( $S, pkS ) ▶₁ #s )
      case Register_key
      solve( Accept( $R, $S, %m, d2 ) @ #j )
        case Accept_first
        by contradiction /* from formulas */
      next
        case Accept_gap
        by contradiction /* from formulas */
      next
        case Accept_next
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case Accept_next
  simplify
  solve( !Pk( $S, pk(x) ) ▶₂ #i )
    case Register_key
    solve( !Pk( $S, pkS ) ▶₁ #s )
      case Register_key
      solve( Accept( $R, $S, %m, d2 ) @ #j )
        case Accept_first
        by contradiction /* from formulas */
      next
        case Accept_gap
        by contradiction /* from formulas */
      next
        case Accept_next
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

lemma executable_two_frames_in_order:
  exists-trace
  "∃ R S d1 d2 #i #j.
    (((Accept( R, S, %1, d1 ) @ #i) ∧ (Accept( R, S, (%1%+%1), d2 ) @ #j)) ∧
     (#i < #j)) ∧
    (¬(∃ X #r. Reveal( X ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ R S d1 d2 #i #j.
  (Accept( R, S, %1, d1 ) @ #i) ∧ (Accept( R, S, (%1%+%1), d2 ) @ #j)
 ∧
  (#i < #j) ∧ (∀ X #r. (Reveal( X ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Accept( R, S, %1, d1 ) @ #i )
  case Accept_first
  solve( Rcv( ~rid, $R, $S, 'none' ) ▶₀ #i )
    case Receiver_start
    solve( !Pk( $S, pk(x) ) ▶₂ #i )
      case Register_key
      solve( Accept( $R, $S, (%1%+%1), d2 ) @ #j )
        case Accept_next
        solve( !Pk( $S, pk(x) ) ▶₂ #j )
          case Register_key
          solve( !KU( sign(<'authbc', $S, %1, d1>, ~sk) ) @ #vk.11 )
            case Send
            solve( !Ltk( $S, sk.1 ) ▶₀ #s.1 )
              case Register_key
              solve( !KU( sign(<'authbc', $S, (%1%+%1), d2>, ~sk) ) @ #vk.15 )
                case Send
                solve( Rcv( ~rid, $R, $S, %1 ) ▶₀ #j )
                  case Accept_first
                  solve( Snd( ~sid, $S, %1 ) ▶₀ #vr.1 )
                    case Sender_start
                    solve( Snd( ~sid, $S, (%1%+%1) ) ▶₀ #vr.3 )
                      case Send
                      solve( !KU( ~data ) @ #vk.12 )
                        case Send
                        solve( !KU( ~data.1 ) @ #vk.15 )
                          case Send
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

