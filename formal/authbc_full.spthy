theory AUTHBC_Frames_Full
begin

/*
 * Revision A6, after registration (predictions/A6.md, outcome): the registered model
 * (formal/authbc.spthy) — same frame, chain link, clock, rules, restrictions and lemma
 * statements — with the three changes that made the smaller models settle: each counter in a
 * state fact keyed by a fresh session id (Snd(~sid, ..), Rcv(~rid, ..)); the receiver's session
 * started by a rule of its own; the clock as persistent ticks whose reads are held to the latest
 * tick (formal/authbc_time.spthy). Plus the helper lemmas of formal/authbc_counters.spthy.
 *
 * Kept as an attempt: within 1 GB a lemma, the receiver's counter invariant and several
 * property lemmas did not settle here (the outcome lists which). Lemmas 1-4 are proven in
 * formal/authbc_counters.spthy and the registered model, lemma 5 in formal/authbc_time.spthy.
 * Assumption A1 and the code mapping as in formal/authbc.spthy.
 */

builtins: signing, hashing, natural-numbers

/* ---------------------------------------------------------------- keys and the adversary */

rule Register_key:
    [ Fr(~sk) ]
  --[ OnlyOnce(<'key', $S>) ]->
    [ !Ltk($S, ~sk), !Pk($S, pk(~sk)), Out(pk(~sk)) ]

// The adversary may compromise any sender's key (the plan's Reveal rule).
rule Reveal_key:
    [ !Ltk($S, sk) ]
  --[ Reveal($S) ]->
    [ Out(sk) ]

/* ---------------------------------------------------------------- the clock */

rule Clock_start:
    [ ]
  --[ OnlyOnce('clock'), Tick(%1) ]->
    [ Clock(%1), !Time(%1) ]

rule Clock_tick:
    [ Clock(%t) ]
  --[ Tick(%t %+ %1) ]->
    [ Clock(%t %+ %1), !Time(%t %+ %1) ]

/* ---------------------------------------------------------------- the sender */

rule Sender_start:
    [ !Ltk($S, sk), Fr(~sid) ]
  --[ OnlyOnce(<'sender', $S>), SenderStart($S, ~sid) ]->
    [ Snd(~sid, $S, %1, 'genesis') ]

rule Send:
    let frame = <'authbc', $S, %seq, link, ~data, %t>
    in
    [ Snd(~sid, $S, %seq, link), !Ltk($S, sk), Fr(~data), !Time(%t) ]
  --[ Sent($S, %seq, link, ~data, %t), SentIn(~sid, $S, %seq), Latest(%t) ]->
    [ Snd(~sid, $S, %seq %+ %1, h(frame)), Out(<frame, sign(frame, sk)>) ]

/* ---------------------------------------------------------------- the receiver */

rule Receiver_start:
    [ Fr(~rid), !Pk($S, pkS) ]
  --[ OnlyOnce(<'receiver', $R, $S>), ReceiverStart($R, $S, ~rid) ]->
    [ Rcv(~rid, $R, $S, 'none', 'none') ]

// The first frame a receiver takes from a sender: any sequence number.
rule Accept_first:
    let frame = <'authbc', $S, %seq, link, data, %t>
    in
    [ Rcv(~rid, $R, $S, 'none', 'none'), In(<frame, sig>), !Pk($S, pkS), !Time(%now) ]
  --[ Eq(verify(sig, frame, pkS), true), Latest(%now),
      Fresh(%t, %now),
      Accept($R, $S, %seq, link, data, %t, %now), AcceptIn(~rid, $R, $S, %seq) ]->
    [ Rcv(~rid, $R, $S, %seq, h(frame)), !Stored($R, $S, %seq, frame) ]

// The next frame in sequence: its link must be the hash of the frame accepted last.
rule Accept_next:
    let frame = <'authbc', $S, %last %+ %1, last_hash, data, %t>
    in
    [ Rcv(~rid, $R, $S, %last, last_hash), In(<frame, sig>), !Pk($S, pkS), !Time(%now) ]
  --[ Eq(verify(sig, frame, pkS), true), Latest(%now),
      Fresh(%t, %now),
      Accept($R, $S, %last %+ %1, last_hash, data, %t, %now),
      AcceptIn(~rid, $R, $S, %last %+ %1),
      Contiguous($R, $S, %last, %last %+ %1) ]->
    [ Rcv(~rid, $R, $S, %last %+ %1, h(frame)), !Stored($R, $S, %last %+ %1, frame) ]

// A frame that skips one or more sequence numbers: accepted, and the gap is recorded.
rule Accept_gap:
    let frame = <'authbc', $S, %seq, link, data, %t>
    in
    [ Rcv(~rid, $R, $S, %last, last_hash), In(<frame, sig>), !Pk($S, pkS), !Time(%now) ]
  --[ Eq(verify(sig, frame, pkS), true), Latest(%now),
      Less(%last %+ %1, %seq),
      Fresh(%t, %now),
      Accept($R, $S, %seq, link, data, %t, %now), AcceptIn(~rid, $R, $S, %seq),
      Gap($R, $S, %last, %seq) ]->
    [ Rcv(~rid, $R, $S, %seq, h(frame)), !Stored($R, $S, %seq, frame) ]

// Two valid frames of one sender with one sequence number and different contents: kept as
// transferable evidence (LeanReceiver.evidence). Nothing is accepted by this rule.
rule Evidence:
    let held    = <'authbc', $S, %seq, l1, d1, %t1>
        offered = <'authbc', $S, %seq, l2, d2, %t2>
    in
    [ !Stored($R, $S, %seq, held), In(<offered, sig>), !Pk($S, pkS) ]
  --[ Eq(verify(sig, offered, pkS), true), Neq(held, offered),
      Equivocation($R, $S, %seq) ]->
    [ ]

/* ---------------------------------------------------------------- restrictions */

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction Inequality:
  "All x #i. Neq(x, x) @ #i ==> F"

restriction Less_than:
  "All x y #i. Less(x, y) @ #i ==> x << y"

restriction Only_once:
  "All x #i #j. OnlyOnce(x) @ #i & OnlyOnce(x) @ #j ==> #i = #j"

// A read of the clock is its current value: no later tick has happened yet.
restriction Latest_tick:
  "All %t %u #i #j. Latest(%t) @ #i & Tick(%u) @ #j & #j < #i ==> not (%t << %u)"

#ifdef TIME
// The receiver's window (A5): stamped at most one tick before now.
restriction Fresh_window:
  "All %t %now #i. Fresh(%t, %now) @ #i ==> (%now = %t) | (%now = %t %+ %1) | (%now << %t)"
#endif

/* ---------------------------------------------------------------- helpers (added after
 * registration): the counters only increase, per session and so per name */

lemma sender_session_counter_increases [reuse]:
  "All sid S %n %m #i #j.
      SentIn(sid, S, %n) @ #i & SentIn(sid, S, %m) @ #j & #i < #j ==> %n << %m"

lemma sender_session_has_start [use_induction, reuse]:
  "All sid S %n #i. SentIn(sid, S, %n) @ #i ==> Ex #s. SenderStart(S, sid) @ #s & #s < #i"

lemma one_session_per_sender [reuse]:
  "All s1 s2 S %n %m #i #j. SentIn(s1, S, %n) @ #i & SentIn(s2, S, %m) @ #j ==> s1 = s2"

lemma receiver_session_counter_increases [use_induction, reuse]:
  "All rid R S %n %m #i #j.
      AcceptIn(rid, R, S, %n) @ #i & AcceptIn(rid, R, S, %m) @ #j & #i < #j ==> %n << %m"

lemma receiver_session_has_start [use_induction, reuse]:
  "All rid R S %n #i.
      AcceptIn(rid, R, S, %n) @ #i ==> Ex #s. ReceiverStart(R, S, rid) @ #s & #s < #i"

lemma one_session_per_receiver [reuse]:
  "All r1 r2 R S %n %m #i #j.
      AcceptIn(r1, R, S, %n) @ #i & AcceptIn(r2, R, S, %m) @ #j ==> r1 = r2"

/* ---------------------------------------------------------------- sanity: it runs */

lemma executable_two_frames_in_order:
  exists-trace
  "Ex R S l1 d1 t1 n1 l2 d2 t2 n2 #i #j.
      Accept(R, S, %1, l1, d1, t1, n1) @ #i & Accept(R, S, %1 %+ %1, l2, d2, t2, n2) @ #j
    & #i < #j & not (Ex X #r. Reveal(X) @ #r)"

/* ---------------------------------------------------------------- 1. origin and integrity */

// Every accepted frame was sent, with exactly this content, by the sender it names, unless
// that sender's key was revealed.
lemma origin_and_integrity:
  "All R S seq link data t now #i.
      Accept(R, S, seq, link, data, t, now) @ #i
    ==> (Ex #j. Sent(S, seq, link, data, t) @ #j & #j < #i)
      | (Ex #r. Reveal(S) @ #r & #r < #i)"

/* ---------------------------------------------------------------- 2. no replay */

// A receiver accepts a sequence number of a sender at most once.
lemma no_replay:
  "All R S seq l1 d1 t1 n1 l2 d2 t2 n2 #i #j.
      Accept(R, S, seq, l1, d1, t1, n1) @ #i & Accept(R, S, seq, l2, d2, t2, n2) @ #j
    ==> #i = #j"

// With 1 and 2 together: injective agreement — each sent frame accepted at most once.
lemma injective_agreement:
  "All R S seq link data t now #i.
      Accept(R, S, seq, link, data, t, now) @ #i
    ==> ( (Ex #j. Sent(S, seq, link, data, t) @ #j & #j < #i)
          & not (Ex n2 #i2. Accept(R, S, seq, link, data, t, n2) @ #i2 & not (#i2 = #i)) )
      | (Ex #r. Reveal(S) @ #r & #r < #i)"

/* ---------------------------------------------------------------- 3. equivocation evidence */

// An honest sender never signs two different frames with one sequence number, so evidence of
// equivocation exists only for a sender whose key was revealed (or that misbehaves, which the
// model can only express as the adversary holding its key).
lemma equivocation_implies_revealed_key:
  "All R S seq #i. Equivocation(R, S, seq) @ #i ==> (Ex #r. Reveal(S) @ #r & #r < #i)"

// The evidence rule can fire: an adversary with the key can make a receiver hold it.
lemma equivocation_evidence_reachable:
  exists-trace
  "Ex R S seq #i. Equivocation(R, S, seq) @ #i"

/* ---------------------------------------------------------------- 4. continuity */

// Contiguity is checked by the chain link, not trusted from the sequence number: when a
// receiver takes seq+1 directly after seq, the frame it took at seq is the one the sender
// sent at seq, and the new frame's link is that frame's hash, as the sender computed it.
lemma continuity_follows_the_senders_chain:
  "All R S last next #i.
      Contiguous(R, S, last, next) @ #i
    ==> (Ex l d t l2 d2 t2 #a #b.
            Sent(S, last, l, d, t) @ #a & Sent(S, next, l2, d2, t2) @ #b
          & l2 = h(<'authbc', S, last, l, d, t>))
      | (Ex #r. Reveal(S) @ #r & #r < #i)"

// A receiver that takes seq and then seq+2, never seq+1, records a gap.
lemma a_skipped_frame_is_detected:
  "All R S %n l1 d1 t1 a1 l3 d3 t3 a3 #i #k.
      Accept(R, S, %n, l1, d1, t1, a1) @ #i
    & Accept(R, S, %n %+ %1 %+ %1, l3, d3, t3, a3) @ #k & #i < #k
    & not (Ex l2 d2 t2 a2 #j. Accept(R, S, %n %+ %1, l2, d2, t2, a2) @ #j)
    ==> (Ex #g. Gap(R, S, %n, %n %+ %1 %+ %1) @ #g)"

/* ---------------------------------------------------------------- 5. delayed frames */

// A frame accepted two or more ticks after it was stamped. WITHOUT -D=TIME this trace exists
// (the published receiver accepts a held-back frame); WITH it, it must not.
lemma delayed_frame_accepted:
  exists-trace
  "Ex R S seq link data %t %now #i.
      Accept(R, S, seq, link, data, %t, %now) @ #i
    & (%t %+ %1 %+ %1 = %now | %t %+ %1 %+ %1 << %now)
    & not (Ex X #r. Reveal(X) @ #r)"

#ifdef TIME
// With the window: whatever is accepted was sent by its sender at most one tick earlier.
lemma bounded_delay_freshness:
  "All R S seq link data %t %now #i.
      Accept(R, S, seq, link, data, %t, %now) @ #i
    ==> ( (Ex #j. Sent(S, seq, link, data, %t) @ #j & #j < #i)
          & ((%now = %t) | (%now = %t %+ %1)) )
      | (Ex #r. Reveal(S) @ #r & #r < #i)"
#endif

end
